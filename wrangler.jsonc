{
  // Cloudflare Workers, static assets only: no Worker code, no bindings.
  // `npm run deploy:cloudflare` builds and deploys. Rename before deploying.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betterbagabag",
  // betterbagabag.org is the site's address; the dababon.pro name stays so earlier links keep working.
  "routes": [
    { "pattern": "betterbagabag.org", "custom_domain": true },
    { "pattern": "betterbagabag.dababon.pro", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/districts, /projects/...) serve index.html.
    "not_found_handling": "single-page-application"
  }
}
